# Copy to .env for local development. Never commit .env.
POSTGRES_DB=ontoflow
POSTGRES_USER=ontoflow
POSTGRES_PASSWORD=change-me-local-postgres
REDIS_PASSWORD=change-me-local-redis
FUSEKI_ADMIN_PASSWORD=change-me-local-fuseki
N8N_ENCRYPTION_KEY=change-me-at-least-32-characters-long
N8N_USER=admin
N8N_PASSWORD=change-me-local-n8n
PLATFORM_API_INTERNAL_KEY=change-me-at-least-32-characters-long
NEXT_PUBLIC_PLATFORM_API_URL=http://localhost:8080
JWT_SECRET=change-me-use-a-random-secret-of-at-least-32-bytes
WEB_ORIGIN=http://localhost:3000


# Local HTTP only. Production must use HTTPS and AUTH_COOKIE_SECURE=true.
AUTH_COOKIE_SECURE=false

# Development-only mock credentials and connector encryption key.
CONNECTOR_ENCRYPTION_KEY=change-me-to-a-random-key-at-least-32-characters
ALPHA_MOCK_TOKEN=alpha-local-token
BETA_MOCK_TOKEN=beta-local-token

# Optional Phase 4 providers. Configure provider apps before enabling resources.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/api/v1/sources/github/callback
GITHUB_APP_SLUG=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:8080/api/v1/sources/slack/callback
# Example: {"ontoflow":{"connector":{"resources":{"billing":{"type":"POSTGRESQL","tenant-id":"TENANT_UUID","jdbc-url":"jdbc:postgresql://db:5432/app","view":"reporting.approved_view","id-column":"id"}}}}}
SOURCE_CATALOG_JSON={}
SOURCE_REQUIRE_TLS=true

